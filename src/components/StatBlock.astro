---
interface Props {
  value: string | number;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="text-center">
  <div class="font-display text-5xl text-neutral-950 sm:text-6xl" style="font-weight: 400; letter-spacing: -0.015em; line-height: 1;">{value}</div>
  <div class="mt-3 text-xs font-medium uppercase tracking-wider text-neutral-500">{label}</div>
</div>
