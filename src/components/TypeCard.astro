---
interface Props {
  name: string;
  typeSlug: string;
  count: number;
  description: string;
  href: string;
}

const { name, count, description, href } = Astro.props;
---

<a
  href={href}
  class="card-interactive group block no-underline"
>
  <p class="text-xs font-medium uppercase tracking-wider text-neutral-400">Type</p>
  <h3 class="mt-2 font-display text-2xl font-semibold text-neutral-900" style="letter-spacing: -0.02em;">
    {name}
  </h3>
  <p class="mt-3 text-sm text-neutral-600 leading-relaxed">{description}</p>
  <p class="mt-5 text-sm font-semibold text-neutral-950">
    {count} {count === 1 ? "project" : "projects"} &rarr;
  </p>
</a>
